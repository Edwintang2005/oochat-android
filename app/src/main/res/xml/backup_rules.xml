<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for API 30 and below. See data_extraction_rules.xml for 31+;
  the two lists are kept identical on purpose.

  Backup is left on so the harmless display preferences survive a new device,
  and everything else is excluded. Two separate reasons:

  - Secrets. The Ed25519 identity, its recovery phrase and any agent API key
    live in the *_secure prefs, encrypted under a master key held in the
    Android Keystore. That master key is device-bound and never leaves, so a
    restored blob is undecryptable ciphertext at best. At worst it throws on
    open, and SafePreferencesWrapper falls back to plaintext storage — so
    backing these up would manufacture the very exposure it looks like it is
    guarding. The _standard files are that fallback, and must not leave either.

  - Privacy. Settings tells the user conversations and attachments are stored
    on this device. connectonion_db, attachments/ and the logs make that true.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="connectonion_keys_secure.xml" />
    <exclude domain="sharedpref" path="connectonion_keys_secure_standard.xml" />
    <exclude domain="sharedpref" path="connectonion_config_secure.xml" />
    <exclude domain="sharedpref" path="connectonion_config_secure_standard.xml" />
    <exclude domain="sharedpref" path="connectonion_agent_keys.xml" />
    <exclude domain="sharedpref" path="connectonion_agent_keys_standard.xml" />
    <exclude domain="sharedpref" path="connectonion_prefs.xml" />
    <exclude domain="sharedpref" path="connection_config.xml" />

    <exclude domain="database" path="connectonion_db" />
    <exclude domain="database" path="connectonion_db-shm" />
    <exclude domain="database" path="connectonion_db-wal" />

    <exclude domain="file" path="attachments" />
    <exclude domain="file" path="logs" />
</full-backup-content>
