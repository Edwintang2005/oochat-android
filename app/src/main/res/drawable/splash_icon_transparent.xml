<?xml version="1.0" encoding="utf-8"?>
<!--
    Fully transparent drawable used as the Android 12+ splash icon so the
    cold-start window shows ONLY the brand-green background (no launcher icon).
    See Theme.ConnectOnion.Starting in themes.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
