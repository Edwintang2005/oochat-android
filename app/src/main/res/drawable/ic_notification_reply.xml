<?xml version="1.0" encoding="utf-8"?>
<!--
    Small icon for the agent-reply notification. Alpha-only on purpose: Android
    keeps just the alpha channel of a notification's small icon and tints the
    result itself, so a launcher icon used here renders as a solid white blob.
    A speech bubble rather than the onion mark, because at status-bar size the
    mark is unreadable and the shape has to say "a message arrived".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20,2H4C2.9,2 2,2.9 2,4v18l4,-4h14c1.1,0 2,-0.9 2,-2V4C22,2.9 21.1,2 20,2z" />
</vector>
