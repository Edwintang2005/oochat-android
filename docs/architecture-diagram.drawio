          <mxGeometry height="56" width="215" x="520" y="286" as="geometry" />
        </mxCell>
        <mxCell id="rr4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;AgentRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;agent_profiles + secure config&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="215" x="750" y="286" as="geometry" />
        </mxCell>
        <mxCell id="rr5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;AccountRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;JWT + profile&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="200" x="980" y="286" as="geometry" />
        </mxCell>
        <mxCell id="rr6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;AgentDiscoveryRepository&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="215" x="60" y="352" as="geometry" />
        </mxCell>
        <mxCell id="rr7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;ConnectionConfigRepository&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="215" x="290" y="352" as="geometry" />
        </mxCell>
        <mxCell id="rr8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;DefaultAgentRepository&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="215" x="520" y="352" as="geometry" />
        </mxCell>
        <mxCell id="rr9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;SessionStore&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;MemoryGated → SessionStoreImpl&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="215" x="750" y="352" as="geometry" />
        </mxCell>
        <mxCell id="rr10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;AppSettings / Theme / IgnoredIds&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="200" x="980" y="352" as="geometry" />
        </mxCell>
        <mxCell id="sb" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontStyle=1;fontSize=13;fontColor=#7a5c00;" value="Local storage — data/local/, crypto/" vertex="1">
          <mxGeometry height="240" width="1160" x="40" y="470" as="geometry" />
        </mxCell>
        <mxCell id="ss1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;verticalAlign=top;" value="&lt;b&gt;Room — AppDatabase v12&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;agent_profiles&lt;br&gt;chat_sessions&lt;br&gt;chat_messages&lt;br&gt;session_states&lt;br&gt;pending_messages&lt;br&gt;&lt;br&gt;Seven real migrations, 5→12.&lt;br&gt;Versions 1–4 fall back to a&lt;br&gt;destructive rebuild.&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="270" x="60" y="506" as="geometry" />
        </mxCell>
        <mxCell id="ss2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;verticalAlign=top;" value="&lt;b&gt;DataStore — three files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;app settings (memory toggle,&lt;br&gt;font scale)&lt;br&gt;theme mode&lt;br&gt;ignored message ids&lt;br&gt;&lt;br&gt;Plain preferences: nothing&lt;br&gt;here is sensitive.&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="270" x="350" y="506" as="geometry" />
        </mxCell>
        <mxCell id="ss3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;verticalAlign=top;" value="&lt;b&gt;EncryptedSharedPreferences&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SafePreferencesWrapper over an&lt;br&gt;Android Keystore MasterKey&lt;br&gt;&lt;br&gt;API keys, relay configuration,&lt;br&gt;default agent, Ed25519 private key&lt;br&gt;&lt;br&gt;Falls back to plaintext if the&lt;br&gt;Keystore is unavailable — surfaced&lt;br&gt;as a warning in Settings.&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="270" x="640" y="506" as="geometry" />
        </mxCell>
        <mxCell id="ss4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;verticalAlign=top;" value="&lt;b&gt;App-private files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;filesDir/attachments/*.jpg&lt;br&gt;downscaled and compressed&lt;br&gt;&lt;br&gt;filesDir/voice/*.wav&lt;br&gt;AudioRecord PCM → WAV&lt;br&gt;&lt;br&gt;Written before send so history&lt;br&gt;survives a process restart.&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="250" x="930" y="506" as="geometry" />
        </mxCell>
        <mxCell id="f1" edge="1" parent="1" source="db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.15;exitY=1;entryX=0.15;entryY=0;strokeColor=#7a4d00;strokeWidth=2;fontSize=11;fontColor=#7a4d00;labelBackgroundColor=#ffffff;" target="rb" value="repository calls">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" edge="1" parent="1" source="rb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.85;exitY=0;entryX=0.85;entryY=1;strokeColor=#4b2d6b;strokeWidth=2;fontSize=11;fontColor=#4b2d6b;labelBackgroundColor=#ffffff;" target="db" value="Flow&amp;lt;List&amp;lt;T&amp;gt;&amp;gt; and Result&amp;lt;T&amp;gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" edge="1" parent="1" source="rb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#4b2d6b;strokeWidth=2;fontSize=11;fontColor=#4b2d6b;labelBackgroundColor=#ffffff;" target="sb" value="Room entities, DAO queries and encrypted writes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Composition root.&lt;/b&gt; di/AppContainer.kt builds every repository above exactly once with by lazy and hands it out, so no screen constructs its own database or preference stack. AppContainer is an&lt;br&gt;interface, which is how the test suite substitutes a FakeAppContainer of in-memory fakes without touching production code. connectToAgentUseCase is deliberately a process-wide singleton: an&lt;br&gt;earlier per-ViewModel factory gave LoadingScreen and ChatViewModel a socket each, and the two server sessions then raced to write the same session_states row." vertex="1">
          <mxGeometry height="70" width="1160" x="40" y="730" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-network" name="Fig 2.3 Network and external">
    <mxGraphModel dx="1199" dy="1401" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" value="Figure 2.3 — Network, protocol and external services (detail of layers 5b–6)" vertex="1">
          <mxGeometry height="30" width="1160" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="nb" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontStyle=1;fontSize=13;fontColor=#7a2320;" value="Network / protocol — network/, data/protocol/" vertex="1">
          <mxGeometry height="282" width="1160" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="nn1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;AgentConnection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Owns the OkHttp WebSocket&lt;br&gt;lifecycle. Signs CONNECT,&lt;br&gt;answers PING with PONG,&lt;br&gt;retries 2 / 4 / 8 / 16 / 32 s&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="60" y="94" as="geometry" />
        </mxCell>
        <mxCell id="nn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;ProtocolParser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ServerEvent JSON → ConnectionEvent.&lt;br&gt;stableAssistantId() makes replay&lt;br&gt;idempotent; unknown types are&lt;br&gt;ignored, never treated as errors&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="440" y="94" as="geometry" />
        </mxCell>
        <mxCell id="nn3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;WebSocketFactory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The OkHttp seam. Production uses&lt;br&gt;OkHttpWebSocketFactory; tests&lt;br&gt;inject a fake and drive the whole&lt;br&gt;protocol without a network&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="820" y="94" as="geometry" />
        </mxCell>
        <mxCell id="nn4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;AgentDiscoveryService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Accepts a 0x address as-is, or fetches&lt;br&gt;GET /info to resolve a direct URL&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="360" x="60" y="176" as="geometry" />
        </mxCell>
        <mxCell id="nn5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;VoiceTranscriptionService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(fallback path)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POSTs the recorded WAV with a JWT&lt;br&gt;bearer; refreshes the token once on 401&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="360" x="440" y="176" as="geometry" />
        </mxCell>
        <mxCell id="nn6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;Account HTTP client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Trades an Ed25519 signature for a JWT,&lt;br&gt;then reads the profile (in AccountRepositoryImpl)&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="360" x="820" y="176" as="geometry" />
        </mxCell>
        <mxCell id="nn7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;NetworkMonitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Watches ConnectivityManager, so a&lt;br&gt;dropped radio is reported rather than&lt;br&gt;inferred from a socket that has not&lt;br&gt;noticed yet.&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="360" x="60" y="258" as="geometry" />
        </mxCell>
        <mxCell id="nn8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;SpeechRecognitionService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Drives the platform recogniser on the&lt;br&gt;device and streams partial text while&lt;br&gt;the user speaks. Primary dictation path;&lt;br&gt;falls back to the service beside it.&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="360" x="440" y="258" as="geometry" />
        </mxCell>
        <mxCell id="fo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Client → server frames&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;CONNECT&lt;/b&gt; — starts an authenticated session.&lt;br&gt;Ed25519 signature over canonical payload JSON;&lt;br&gt;carries session_id to resume a previous session.&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt; — one user prompt, with input_id and&lt;br&gt;optional base64 image data URLs.&lt;br&gt;&lt;br&gt;&lt;b&gt;PONG&lt;/b&gt; — automatic answer to a server PING.&lt;br&gt;&lt;br&gt;&lt;b&gt;ASK_USER_RESPONSE&lt;/b&gt; — the user answers a card.&lt;br&gt;&lt;br&gt;&lt;b&gt;APPROVAL_RESPONSE&lt;/b&gt; — allow or deny a tool call.&lt;br&gt;&lt;br&gt;&lt;b&gt;ONBOARD_SUBMIT&lt;/b&gt; — answers an onboarding gate&lt;br&gt;with an invite code or a payment. Signed like&lt;br&gt;CONNECT, with no top-level timestamp.&lt;/font&gt;" vertex="1">
          <mxGeometry height="290" width="560" x="40" y="382" as="geometry" />
        </mxCell>
        <mxCell id="fi" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Server → client events&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Session:&lt;/b&gt; CONNECTED, session_sync, OUTPUT, PING, ERROR&lt;br&gt;&lt;br&gt;&lt;b&gt;Model turn:&lt;/b&gt; llm_call, llm_result, thinking, assistant,&lt;br&gt;agent_image&lt;br&gt;&lt;br&gt;&lt;b&gt;Tools:&lt;/b&gt; tool_call, tool_result, tool_blocked&lt;br&gt;&lt;br&gt;&lt;b&gt;Cards that block on the user:&lt;/b&gt; ask_user,&lt;br&gt;approval_needed, plan_review, ulw_turns_reached,&lt;br&gt;ONBOARD_REQUIRED, ONBOARD_SUCCESS&lt;br&gt;&lt;br&gt;&lt;b&gt;Other:&lt;/b&gt; intent, eval, compact, files_received&lt;br&gt;&lt;br&gt;&lt;b&gt;Ignored:&lt;/b&gt; user_input (the local item is already&lt;br&gt;authoritative), plus any type this client does not know&lt;/font&gt;" vertex="1">
          <mxGeometry height="290" width="560" x="640" y="382" as="geometry" />
        </mxCell>
        <mxCell id="xb" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontStyle=1;fontSize=13;fontColor=#333333;" value="External systems — not part of this repository" vertex="1">
          <mxGeometry height="180" width="1160" x="40" y="720" as="geometry" />
        </mxCell>
        <mxCell id="xx1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=12;verticalAlign=top;" value="&lt;b&gt;ConnectOnion relay&lt;/b&gt;&lt;br&gt;oo.openonion.ai&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;wss://…/ws/input — chat&lt;br&gt;GET /api/relay/agents — discovery&lt;br&gt;POST /api/v1/auth — signature → JWT&lt;br&gt;GET /api/v1/auth/me — profile&lt;br&gt;POST /v1/chat/completions — transcription&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="360" x="60" y="754" as="geometry" />
        </mxCell>
        <mxCell id="xx2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=12;verticalAlign=top;" value="&lt;b&gt;Self-hosted / direct agent&lt;/b&gt;&lt;br&gt;any host the user supplies&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ws(s)://&amp;lt;host&amp;gt;/ws — chat, no relay&lt;br&gt;GET /info — address resolution&lt;br&gt;&lt;br&gt;How a developer connects to an agent&lt;br&gt;running on their own machine.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="360" x="440" y="754" as="geometry" />
        </mxCell>
        <mxCell id="xx3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=12;verticalAlign=top;" value="&lt;b&gt;External browser&lt;/b&gt;&lt;br&gt;o.openonion.ai/purchase&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Account top-up. Opened with&lt;br&gt;Intent.ACTION_VIEW and handed to&lt;br&gt;the OS — the app never handles&lt;br&gt;payment details itself.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="360" x="820" y="754" as="geometry" />
        </mxCell>
        <mxCell id="g1" edge="1" parent="1" source="nb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;strokeColor=#7a2320;strokeWidth=2;" target="fo" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g2" edge="1" parent="1" source="nb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;entryX=0.75;entryY=0;strokeColor=#333333;strokeWidth=2;endArrow=none;startArrow=classic;" target="fi" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" edge="1" parent="1" source="fo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;strokeWidth=2;startArrow=classic;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="xb" value="over one WebSocket, plus HTTPS for discovery, account and transcription">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" value="&lt;b&gt;No backend of our own.&lt;/b&gt; There is no account system and no server-side user record: identity is an Ed25519 keypair generated on the device, and every request is authenticated by signing with it.&lt;br&gt;A relay may replay a transcript after reconnecting, so assistant output is keyed by stableAssistantId() — a hash of the trimmed content — which makes replay idempotent instead of duplicating the conversation." vertex="1">
          <mxGeometry height="50" width="1160" x="40" y="915" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
