# Copy to keystore.properties (git-ignored) to sign the release build.
# Without this file the release APK is simply unsigned, and everything else
# — debug builds, tests, CI — is unaffected.
#
# Create the keystore first, choosing your own passwords:
#
#   keytool -genkeypair -v -keystore release.jks -alias connectonion \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release.jks and this file out of git. Both are already ignored.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=connectonion
keyPassword=CHANGE_ME
